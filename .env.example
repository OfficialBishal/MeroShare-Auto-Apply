# Legacy MeroShare credentials format — preserved only for upgrading
# from very old installs. Modern installs add accounts through the GUI
# (Settings → Accounts → "+ Add account"); credentials are stored in
# the OS keystore (macOS Keychain / Windows Credential Manager / Linux
# Secret Service), NOT in .env.
#
# If you have a legacy .env from a pre-multi-account install, copy this
# file to .env, fill it in, and run the tool once — it will migrate
# the values into accounts.json + the keystore on first launch and
# never read .env again.
#
# DO NOT commit .env. The .gitignore excludes it; new installs do not
# need this file at all.

# Your Depository Participant ID (the number in parentheses on the
# MeroShare login dropdown). Example: NIMB ACE CAPITAL LIMITED (10600)
# → use 10600
MEROSHARE_DP_ID=

# Your MeroShare username (BOID number)
MEROSHARE_USERNAME=

# Your MeroShare password
MEROSHARE_PASSWORD=

# Your CRN (Customer Reference Number from your bank)
MEROSHARE_CRN=

# Your 4-digit MeroShare Transaction PIN
MEROSHARE_PIN=
